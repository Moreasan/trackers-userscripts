{
  "presets": [
    "@babel/preset-typescript",
    [
      "@babel/preset-env",
      {
        "targets": {
          "browsers": [
            "last 1 chrome version",
            "last 1 firefox version"
          ]
        }
      }
    ]
  ],
  "plugins": [
    ["babel-plugin-polyfill-corejs3", { "method": "entry-global" }]
  ]
}
