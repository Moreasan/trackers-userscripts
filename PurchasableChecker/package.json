{
  "name": "purchasable-checker",
  "description": "Checks Requests pages searching purchasable field",
  "version": "0.0.1",
  "author": {
    "name": "Mea01"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--import tsx' webpack server --config-node-env development --config config/webpack.config.ts",
    "build": "NODE_OPTIONS='--import tsx' webpack --config-node-env production --progress --config config/webpack.config.ts",
    "format": "prettier --write --ignore-unknown src"
  },
  "private": true,
  "dependencies": {
    "@trim21/gm-fetch": "^0.3.0",
    "common": "1.0.0",
    "jquery": "^4.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "prettier --ignore-path ./.prettierignore --write "
    ]
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@crashmax/prettier-config": "^3.2.1",
    "@types/copy-webpack-plugin": "^10.1.0",
    "@types/tampermonkey": "^5.5.0",
    "@types/terser-webpack-plugin": "^5.2.0",
    "@types/webpack": "^5.28.1",
    "@types/webpack-dev-server": "^4.7.2",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "sass-loader": "^17.1.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.7",
    "tsx": "^4.23.15",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.3",
    "webpack": "^5.78.0",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "webpack-userscript": "^3.1.0"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 firefox version"
  ]
