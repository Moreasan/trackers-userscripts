  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "dist/src/index.d.ts",
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@babel/traverse": "^8.1.0",
    "@crashmax/prettier-config": "^3.2.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/copy-webpack-plugin": "^10.1.0",
    "@types/esprima": "^4.0.5",
    "@types/estraverse": "^5.1.5",
    "@types/tampermonkey": "^4.0.10",
    "@types/terser-webpack-plugin": "^5.2.0",
    "@types/webpack": "^5.28.1",
    "@types/webpack-dev-server": "^4.7.2",
    "babel-loader": "^10.1.1",
    "esprima": "^4.0.1",
    "estraverse": "^5.3.0",
    "rollup": "^4.68.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.5.0",
    "typescript": "^6.0.3",
    "webpack": "^5.79.0",
    "webpack-cli": "^5.0.1"
  },
  "exports": {
